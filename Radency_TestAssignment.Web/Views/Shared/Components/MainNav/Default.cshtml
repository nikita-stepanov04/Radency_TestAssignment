@model MainNavViewModel

<nav class="navbar navbar-expand-sm bg-body-tertiary shadow-sm">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold text-primary" href="#">Radency_PMS</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            @if (Model.IsAuthenticated)
            {
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Application" asp-action="Index">
                            <i class="fa-solid fa-file-lines me-1"></i> Applications
                        </a>
                    </li>

                    @if (Model.IsApplicant)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Unit" asp-action="Index">
                                <i class="fa-solid fa-building me-1"></i> Available units
                            </a>
                        </li>
                    }

                    @if (Model.IsManager)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Property" asp-action="Index">
                                <i class="fa-solid fa-city me-1"></i> Properties
                            </a>
                        </li>
                    }
                </ul>

                @if (Model.IsManager)
                {
                    <button type="button" class="btn btn-success me-3"
                            data-modal-url="@Url.Action("Create", "Property")">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                }

                <form asp-controller="User" asp-action="Logout" method="post" class="d-inline">
                    <button class="btn btn-outline-secondary">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </button>
                </form>
            }
        </div>
    </div>
</nav>
