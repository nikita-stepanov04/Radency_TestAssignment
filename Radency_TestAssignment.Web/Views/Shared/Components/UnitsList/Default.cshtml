@model PagedResult<UnitListItemDTO>
@{
    var propertyId = (int)ViewData["PropertyId"]!;
    var pager = new PagerViewModel(
        Model.Page,
        Model.TotalPages,
        p => Url.Action("List", "Unit", new { propertyId, page = p }));
}

@if (!Model.Items.Any())
{
    <partial name="Lists/EmptyState" model="@("No units yet.")" />
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Unit</th>
                <th>Type</th>
                <th>Bedrooms</th>
                <th>Monthly rent</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Items)
            {
                var actions = new RowActionsViewModel(
                    Url.Action("Edit", "Unit", new { id = u.ID })!,
                    Url.Action("Delete", "Unit", new { id = u.ID })!);

                <tr>
                    <td>@u.UnitNumber</td>
                    <td>@u.UnitType</td>
                    <td>@u.Bedrooms</td>
                    <td>@u.MonthlyRent.ToString("C2")</td>
                    <td>
                        @if (u.IsAvailable)
                        {
                            <span class="badge text-bg-success">Available</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Leased</span>
                        }
                    </td>
                    <td class="text-end">
                        <partial name="Lists/RowActions" model="actions" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="Lists/Pager" model="pager" />
}