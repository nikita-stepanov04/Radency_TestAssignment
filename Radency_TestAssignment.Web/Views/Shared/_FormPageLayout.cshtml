@{
    Layout = "_Layout";
}

<div class="page bg-lightblue">
    <div class="d-flex align-items-center content">
        <div class="container py-lg-3 py-xxl-5">
            <div class="@(ViewBag.IsWide == "true"
                    ? "a col-lg-8 offset-lg-2 col-md-10 offset-md-1 col-12 offset-0"
                    : "b col-lg-6 offset-lg-3 col-md-8 offset-md-2 col-12 offset-0")">
                <div class="main-block">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("Footer")
</div>